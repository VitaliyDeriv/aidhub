# Скопіюйте в .env.sandbox і замініть значення. Файл .env.sandbox у git не потрапляє.
APP_ENV=sandbox
DEBUG=true
DATABASE_URL=postgresql+psycopg://aidhub:aidhub@localhost:5432/aidhub_sandbox
SECRET_KEY=replace-with-random-string-at-least-16-chars
COOKIE_SECURE=false
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=replace-with-strong-password
