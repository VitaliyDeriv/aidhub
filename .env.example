# Для docker compose: cp .env.example .env і змініть значення.
APP_ENV=sandbox
DEBUG=false
COOKIE_SECURE=false
SECRET_KEY=replace-with-random-string-at-least-16-chars
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=replace-with-strong-password

POSTGRES_USER=aidhub
POSTGRES_PASSWORD=replace-with-db-password
POSTGRES_DB=aidhub_sandbox
