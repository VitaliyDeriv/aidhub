# Скопіюйте в .env.production. У production DEBUG завжди false,
# SECRET_KEY генеруйте командою: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_ENV=production
DEBUG=false
DATABASE_URL=postgresql+psycopg://aidhub_prod:CHANGE_ME@db-host:5432/aidhub_production
SECRET_KEY=
COOKIE_SECURE=true
ADMIN_EMAIL=
ADMIN_PASSWORD=
